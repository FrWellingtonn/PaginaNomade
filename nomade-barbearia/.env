# ============================================
# CONFIGURAÇÕES DO FRONT-END
# ============================================
PORT=3000
REACT_APP_ENV=development

# ============================================
# URL DO BACK-END (API)
# ============================================
REACT_APP_API_URL=http://localhost:5000
REACT_APP_API_BASE_URL=http://localhost:5000/api

# ============================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# (Normalmente usado apenas como referência no front-end)
# ============================================
REACT_APP_DB_HOST=localhost
REACT_APP_DB_PORT=5432
REACT_APP_DB_NAME=nomade_barbearia
REACT_APP_DB_USER=postgres
REACT_APP_DB_PASSWORD=your_password_here

# ============================================
# CONFIGURAÇÕES DE AUTENTICAÇÃO
# ============================================
REACT_APP_JWT_SECRET=your_jwt_secret_key_here
REACT_APP_TOKEN_KEY=nomade_token

# ============================================
# OUTRAS CONFIGURAÇÕES
# ============================================
REACT_APP_APP_NAME=Nomade Barbearia
REACT_APP_APP_VERSION=1.0.0
